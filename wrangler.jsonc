{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transcript-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transcript-studio-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "transcript-studio-media"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "TRANSCRIPT_QUEUE", "queue": "transcript-studio-jobs" }
    ],
    "consumers": [
      {
        "queue": "transcript-studio-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "observability": { "enabled": true }
}
